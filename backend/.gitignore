"""
ReliefRoute Backend - Flask Application
Member 3: Backend + Offline System

This is the entry point for the backend server.
Run it with:  python app.py
"""

from flask import Flask, jsonify
from dotenv import load_dotenv
import os

# Load variables from the .env file (like our Supabase URL and keys)
# into the environment, so we can read them with os.environ.get(...)
load_dotenv()

app = Flask(__name__)


def success_response(data=None):
    """
    Every successful API response should look the same shape:
    { "success": true, "data": {...}, "error": null }
    This helper makes sure we never forget that shape.
    """
    return jsonify({
        "success": True,
        "data": data,
        "error": None
    })


def error_response(code, message, status_code=400):
    """
    Every failed API response should look the same shape:
    { "success": false, "data": null, "error": { "code": ..., "message": ... } }
    """
    response = jsonify({
        "success": False,
        "data": None,
        "error": {
            "code": code,
            "message": message
        }
    })
    response.status_code = status_code
    return response


@app.route("/api/health", methods=["GET"])
def health_check():
    """
    A simple endpoint to check that the server is alive.
    Visiting this in a browser or with curl should return success:true.
    This does NOT check Supabase yet - that comes in the next step.
    """
    return success_response({"status": "ReliefRoute backend is running"})


if __name__ == "__main__":
    # debug=True auto-reloads the server when you save a file change.
    # Turn this off before the real hackathon demo for stability.
    app.run(debug=True, port=5000)

